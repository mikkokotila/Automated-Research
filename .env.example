# Canary operator configuration (redacted example -- no real secrets here).
# Copy to .env for local helper scripts if needed; never commit a filled copy.
# The provider key is supplied to the broker ONLY via process environment at
# `gate_service.sh start` time (see docs/TOKEN_BOUNDARY.md), never from a file.

# Fresh, legitimately authorized provider credential. Obtain from the owner
# through the provider's own key management; never copy from archived logs.
MUSE_API_KEY=

# Optional: Semantic Scholar API key for a higher literature rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# Contact address sent to OpenAlex (polite pool). Any valid address works.
OPENALEX_MAILTO=operator@example.com

# Broker endpoint for workers. Workers receive ONLY the run-scoped
# CANARY_GATE_TOKEN minted per launch -- never the keys above.
CANARY_GATE_URL=http://canary-gate:8787
