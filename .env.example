# Canary operator configuration (redacted example -- no real secrets here).
# Copy to .env (gitignored; never commit a filled copy) and `gate_service.sh
# start` picks it up automatically when MUSE_API_KEY is not already set.
# The broker still receives the key ONLY via process environment at start
# time (see docs/TOKEN_BOUNDARY.md): never baked into images, never
# committed, never visible to workers. Explicit environment always wins.

# Fresh, legitimately authorized provider credential. Obtain from the owner
# through the provider's own key management; never copy from archived logs.
MUSE_API_KEY=

# Optional: OpenAlex API key (free tier) for a higher literature rate
# limit. The broker injects it server-side; workers never see it. Without
# one, OpenAlex runs on the keyless budget. (The old mailto polite pool
# is retired by OpenAlex; Semantic Scholar support was removed.)
OPENALEX_API_KEY=

# Broker endpoint for workers. Workers receive ONLY the run-scoped
# CANARY_GATE_TOKEN minted per launch -- never the keys above.
CANARY_GATE_URL=http://canary-gate:8787
