{"files":[{"path":"/Users/mikkokotila/Automated-Research/src/autoresearch/reflect.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":68,"lines":["+\"\"\"Reflect: review procedural notes, document how the system must improve.\"\"\"","+","+from __future__ import annotations","+","+import json","+import re","+from dataclasses import dataclass","+","+from .synthesize import Completer","+","+SYSTEM = (","+    \"You are the system's self-critic. Review the procedural notes and outcome. \"","+    \"Reply with ONLY a JSON object: {\\\"reflection\\\": \\\"markdown\\\", \\\"proposals\\\": \"","+    \"[{\\\"id\\\": \\\"p1\\\", \\\"target\\\": \\\"src/autoresearch/<file>.py\\\", \"","+    \"\\\"change\\\": \\\"concrete edit\\\", \\\"reason\\\": \\\"why\\\"}]}. Rules: at most 3 \"","+    \"proposals; each must name one file under src/autoresearch/; never propose \"","+    \"changes to tests, workflows, Docker files, lockfiles, or improve.py itself; \"","+    \"prefer small, verifiable fixes over redesigns. If nothing is worth changing, \"","+    \"use []. The reflection markdown covers: what worked, what failed, and what \"","+    \"to change next.\"","+)","+","+","+@dataclass(frozen=True)","+class Proposal:","+    id: str","+    target: str","+    change: str","+    reason: str","+","+","+@dataclass(frozen=True)","+class ReflectionDoc:","+    markdown: str","+    proposals: tuple[Proposal, ...]","+","+","+def parse_reflection(text: str) -> ReflectionDoc:","+    match = re.search(r\"\\{.*\\}\", text, re.DOTALL)","+    if not match:","+        return ReflectionDoc(markdown=text.strip() or \"no reflection produced\", proposals=())","+    try:","+        raw = json.loads(match.group(0))","+    except json.JSONDecodeError:","+        return ReflectionDoc(markdown=text.strip(), proposals=())","+    if not isinstance(raw, dict):","+        return ReflectionDoc(markdown=text.strip(), proposals=())","+    out: list[Proposal] = []","+    for item in raw.get(\"proposals\", []) or []:","+        if not isinstance(item, dict):","+            continue","+        target = str(item.get(\"target\", \"\")).strip()","+        change = str(item.get(\"change\", \"\")).strip()","+        if not target or not change:","+            continue","+        out.append(Proposal(","+            id=str(item.get(\"id\", f\"p{len(out) + 1}\")),","+            target=target,","+            change=change[:1000],","+            reason=str(item.get(\"reason\", \"\"))[:500],","+        ))","+    md = str(raw.get(\"reflection\", \"\")).strip() or \"no reflection produced\"","+    return ReflectionDoc(markdown=md, proposals=tuple(out[:3]))","+","+","+def reflect(journal_text: str, outcome: str, client: Completer) -> ReflectionDoc:","+    user = f\"Procedural notes:\\n{journal_text}\\n\\nOutcome:\\n{outcome}\\n\\nReflect and propose improvements.\"","+    return parse_reflection(client.complete(SYSTEM, user))"]}]}]}